Import "../Core/Lib_Malterlib.MTarget"

%Group "{Malterlib}/{Lib_Malterlib_Stream}"
{
	%Group "Stream"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Stream/^*"
		}
		%File "Source/*"
		%Group "Documentation"
		{
			%File "Documentation/*"
		}
	}
}


Property
{
	MalterlibLibrary_Stream define bool = MalterlibLibrary_All
	MalterlibSubLibraries =+ "Stream"
	{
		!!MalterlibLibrary_Stream true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_Stream define bool = true
	MalterlibIncludeRoots =+ "Include"->MakeAbsolute()
	{
		!!MalterlibLibrary_Stream true
	}
}

Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests =+ "Malterlib_Stream"
	MalterlibTestFiles_Malterlib_Stream define [type(CEntity)] = ["Test/*"->MakeAbsolute()]
}
